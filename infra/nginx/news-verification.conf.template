# DuckDNS HTTPS와 Spring Boot Blue Green Reverse Proxy
map $http_x_articlecheck_origin $articlecheck_origin_allowed {
    default 0;
    "__ORIGIN_PROXY_SECRET__" 1;
}

upstream news_verification_backend {
    include /etc/nginx/news-verification/active-backend.conf;
    keepalive 16;
}

server {
    listen 80;
    server_name __BACKEND_DUCKDNS_HOST__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name __BACKEND_DUCKDNS_HOST__;

    ssl_certificate /etc/letsencrypt/live/__BACKEND_DUCKDNS_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__BACKEND_DUCKDNS_HOST__/privkey.pem;

    client_max_body_size 64k;

    location ^~ /actuator/ {
        return 404;
    }

    location ~ ^/(api|oauth2|oauth)(/|$) {
        if ($articlecheck_origin_allowed = 0) { return 404; }
        if ($http_x_articlecheck_client_ip = "") { return 404; }
        access_log off;
        proxy_pass http://news_verification_backend;
        proxy_http_version 1.1;
        proxy_set_header Host __FRONTEND_PUBLIC_HOST__;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP $http_x_articlecheck_client_ip;
        proxy_set_header X-Forwarded-For $http_x_articlecheck_client_ip;
        proxy_set_header X-Forwarded-Host __FRONTEND_PUBLIC_HOST__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Articlecheck-Origin "";
        proxy_set_header X-Articlecheck-Client-IP "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location / {
        return 404;
    }
}
