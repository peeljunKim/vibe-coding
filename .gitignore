# Repository 제외용 Local 설정과 생성물

# 환경 변수와 Local 덮어쓰기
.env
.env.*
**/.env
**/.env.*
!**/.env.template
.envrc
local.properties
**/local.properties
*.local.properties
*.local.yml
*.local.yaml
*.local.json
*.local.toml
.java-version.local
.tool-versions.local

# 자격 증명과 개인키
secrets/
**/secrets/
