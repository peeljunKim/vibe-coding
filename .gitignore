**/service-account*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.der
.npmrc
**/application*.yml
**/application*.yaml

# Local YAML 설정
*.yml
*.yaml

# Frontend 의존성과 생성물
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/.eslintcache
frontend/*.tsbuildinfo
frontend/playwright-report/
frontend/test-results/
npm-debug.log*

# Backend 생성물
backend/target/
*.class
hs_err_pid*
replay_pid*

# 로그
logs/
**/logs/
*.log
*.log.*

# 캐시와 임시 파일
.cache/
**/.cache/
tmp/
**/tmp/
temp/
**/temp/
*.tmp
*.temp
*.swp
*.swo
*~

# IDE 설정
.idea/
.vscode/
.fleet/
*.iml
backend/.classpath
backend/.project
backend/.settings/

# 운영체제 생성 파일
.DS_Store
._*
Thumbs.db
